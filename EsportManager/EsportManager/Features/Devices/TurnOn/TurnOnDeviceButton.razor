@using EsportManager.Resources.Strings
@using MudBlazor
@using EsportManager.Features.Devices.Models
@inject ISnackbar _snackbar

@if (Device != null)
{
    <MudTooltip Text="@AppStrings.TurnOn" Placement="Placement.Top"><MudIconButton OnClick="TurnOnDevice" Icon="@Icons.Material.Filled.Power" Class="pa-0" /></MudTooltip>
}

@code {
    [Parameter]
    public Device Device { get; set; }

    private async Task TurnOnDevice()
    {
        var snackbar = _snackbar.Add(AppStrings.Waiting30Seconds, Severity.Info, key: "ping_snackbar");

        await Device.TurnOn(PingCompletedHandler);

        StateHasChanged();
    }

    private void PingCompletedHandler()
    {

        if (Device.Status == Device.StatusEnum.Online)
        {
            _snackbar.Add(string.Format(AppStrings.DeviceIsOnline, Device.Name), Severity.Success);
        }
        else if (Device.Status == Device.StatusEnum.Offline)
        {
            _snackbar.Add(string.Format(AppStrings.DeviceIsOffline, Device.Name), Severity.Error);
        }

        StateHasChanged();
    }
}