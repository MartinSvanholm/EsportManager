@page "/"
@using CliWrap
@using CliWrap.EventStream
@using EsportManager.Features.Devices.UpdateFortnite
@using MudBlazor
@using EsportManager.Features.Devices.Models
@using System.Diagnostics
@using System.Net
@using EsportManager
@inject ISnackbar _snackbar
@implements IDisposable

<MudTable T="Device" 
    ServerData="GetDevices"
    @bind-SelectedItems="SelectedDevices" 
    Class="ma-5" 
    MultiSelection
    Striped
    SelectOnRowClick="false" 
    Dense 
    LoadingContentBody="loadingContentBody"
    @ref="Table" Loading="IsScanning">
    <ToolBarContent>
        <MudStack Row Justify="Justify.SpaceBetween" Style="width: 100%">
            <MudStack Row>
                <MudText Typo="Typo.h6">Devices</MudText>
                <MudTextField T="string" Value="SearchValue" ValueChanged="OnSearch" Placeholder="Search" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Clearable Disabled="IsScanning" />
                <MudTooltip Text="Scan network for devices" Placement="Placement.Top"><MudIconButton OnClick="ScanForDevices" Icon="@Icons.Material.Filled.CloudSync" Size="Size.Medium" Class="pa-0" /></MudTooltip>
            </MudStack>
            <MudStack Row>
                <MudButton Variant="Variant.Filled" Color="Color.Info">Update fortnite on selected devices</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success">Turn on selected devices</MudButton>
            </MudStack>
        </MudStack>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="name_field" T="Device" InitialDirection="SortDirection.Descending">Name</MudTableSortLabel></MudTh>
        <MudTh>Ip adress</MudTh>
        <MudTh>Mac adress</MudTh>
        <MudTh>Status</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Ip adress">@context.IPAddress</MudTd>
        <MudTd DataLabel="Mac adress">@context.MACAdress</MudTd>
        <MudTd DataLabel="Mac adress">@context.Status.ToString()</MudTd>
        <MudTd>
            <MudStack Row Justify="Justify.FlexEnd" Class="mr-3">
                <UpdateFortniteButton Device="context" />
                <MudTooltip Text="Turn on" Placement="Placement.Top"><MudIconButton OnClick="async () => await TurnOnDevice(context)" Icon="@Icons.Material.Filled.Power" Class="pa-0" /></MudTooltip>
                <MudTooltip Text="Check status" Placement="Placement.Top"><MudIconButton OnClick="() => CheckDeviceStatus(context)" Icon="@Icons.Material.Filled.WifiFind" Class="pa-0" /></MudTooltip>
                <MudTooltip Text="Show details" Placement="Placement.Top"><MudIconButton OnClick="() => context.ShowDetails = !context.ShowDetails" Icon="@Icons.Material.Filled.KeyboardArrowDown" Class="pa-0" /></MudTooltip>
            </MudStack>
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (context.ShowDetails)
        {
            <MudTr>
                <td colspan="12" class="pa-4">
                    <MudStack>
                        @if (context.ProcessQueue.Count > 0)
                        {
                            <MudStack Row Justify="Justify.FlexStart" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.h6">Task queue</MudText>
                                @if (context.ProcessQueue.All(q => q.Status == DeviceProcess.ProcessStatusEnum.Initialized))
                                {
                                    <MudButton OnClick="() => context.StartQueue()" Variant="Variant.Filled" Color="Color.Info" Size="Size.Small">Start queue</MudButton>
                                }
                                <MudTooltip Text="Clear queue" Placement="Placement.Top"><MudIconButton onclick="() => context.ClearQueue()" Icon="@Icons.Material.Filled.DoNotDisturb" Class="pa-0" Color="Color.Error" /></MudTooltip>
                            </MudStack>
                            <MudStack Row Justify="Justify.FlexStart">
                                @foreach (var process in context.ProcessQueue)
                                {
                                    <MudCard>
                                        <MudCardHeader Class="pb-0">
                                            <CardHeaderContent>
                                                <MudStack Row AlignItems="AlignItems.Center">
                                                    <MudText>@process.Name</MudText>
                                                    @if (process != null && process.IsRunning)
                                                    {
                                                        <MudTooltip Text="Stop update" Placement="Placement.Top"><MudIconButton onclick="() => process.Cancel(true)" Icon="@Icons.Material.Filled.DoNotDisturb" Class="pa-0" Color="Color.Error" /></MudTooltip>
                                                    }
                                                </MudStack>
                                            </CardHeaderContent>
                                        </MudCardHeader>
                                        <MudCardContent>
                                            <MudStack Spacing="0" Row>
                                                @if (process.IsRunning)
                                                {
                                                    <MudProgressCircular Color="Color.Info" Value="process.Progress" Indeterminate="process.Progress == 0" Size="Size.Small" />
                                                }
                                                else
                                                {
                                                    <MudIcon Color="Color.Default" Size="Size.Small" Icon="@GetProcessStatusIcon(process)" />
                                                }
                                                <MudText Class="mx-2">Status:</MudText>
                                                <MudText>@process.Status</MudText>
                                            </MudStack>
                                            <MudStack Spacing="0" Row>
                                                <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.ShortText" />
                                                <MudText Class="mx-2">Output:</MudText>
                                                <MudText>@process?.Output</MudText>
                                            </MudStack>
                                        </MudCardContent>
                                    </MudCard>
                                }
                            </MudStack>
                        }
                    </MudStack>
                </td>
            </MudTr>
        }
    </ChildRowContent>
</MudTable>

@code {
    private HashSet<Device> SelectedDevices { get; set; } = [];

    private string SearchValue
    {
        get
        {
            Task<string?> task = Task.Run(() => SecureStorage.GetAsync(Contants.DeviceSearchKey));
            task.Wait();

            return task.Result ?? string.Empty;
        }
        set
        {
            if (string.IsNullOrEmpty(value))
            {
                SecureStorage.Remove(Contants.DeviceSearchKey);
            } 
            else
            {
                Task task = Task.Run(() => SecureStorage.SetAsync(Contants.DeviceSearchKey, value));
                task.Wait();
            }
        }
    }

    private bool IsScanning { get; set; }

    private readonly RenderFragment loadingContentBody = 
        @<text>
            @for (int r = 0; r< 4; r++)
            {
                <MudTr>
                    @for (int c = 0; c< 5; c++)
                    {
                        <MudTd><MudSkeleton /></MudTd>
                    }
                </MudTr>
            }
        </text>
    ;

    private MudTable<Device> Table { get; set; }

    private System.Timers.Timer RefreshTimer { get; set; } = new(500);

    protected override void OnInitialized()
    {
        RefreshTimer.Elapsed += (x, y) => InvokeAsync(StateHasChanged);
        RefreshTimer.Start();
    }

    public void Dispose()
    {
        RefreshTimer.Dispose();
    }

    private string GetProcessStatusIcon(DeviceProcess process)
    {
        switch (process.Status)
        {
            case DeviceProcess.ProcessStatusEnum.Initialized:
                return Icons.Material.Filled.Start;
            case DeviceProcess.ProcessStatusEnum.Running:
                return Icons.Material.Filled.Done;
            case DeviceProcess.ProcessStatusEnum.Finished:
                return Icons.Material.Filled.Done;
            case DeviceProcess.ProcessStatusEnum.FinishedWithError:
                return Icons.Material.Filled.Error;
            case DeviceProcess.ProcessStatusEnum.CancelledByUser:
                return Icons.Material.Filled.Cancel;
            default:
                return string.Empty;
        }
    }

    private async Task<TableData<Device>> GetDevices(TableState state, CancellationToken token)
    {
        List<Device> devices = [];
        string devicesFilePath = Path.Combine(Environment.CurrentDirectory, "devices");

        if (!File.Exists(devicesFilePath))
        {
            return new TableData<Device> { TotalItems = devices.Count, Items = devices };
        }

        string[] lines = await File.ReadAllLinesAsync(devicesFilePath, token);
        foreach (string line in lines.Skip(1))
        {
            devices.Add(new Device(line));
        }

        if (!string.IsNullOrEmpty(SearchValue))
        {
            devices = devices.Where(d => d.Name.Contains(SearchValue)).ToList();
        }

        switch (state.SortLabel)
        {
            case "name_field":
                devices = devices.OrderByDirection(state.SortDirection, o => o.Name).ToList();
                break;
        }

        return new TableData<Device> { TotalItems = devices.Count, Items = devices };
    }

    private async Task ScanForDevices()
    {
        IsScanning = true;

        try
        {
            File.Delete(Path.Combine(Environment.CurrentDirectory, "devices"));
            StateHasChanged();

            var searchResult = await Cli.Wrap("WakeMeOnLan.exe")
                .WithWorkingDirectory(Environment.CurrentDirectory)
                .WithArguments("/scan")
                .ExecuteAsync();

            var saveResult = await Cli.Wrap("WakeMeOnLan.exe")
                .WithWorkingDirectory(Environment.CurrentDirectory)
                .WithArguments("/scomma devices")
                .ExecuteAsync();
        }
        catch (Exception e)
        {
            _snackbar.Add(e.Message, Severity.Error);   
        }

        IsScanning = false;

        await Table.ReloadServerData();
    }

    private async Task OnSearch(string searchValue)
    {
        SearchValue = searchValue;

        await Table.ReloadServerData();
    }

    private async Task TurnOnDevice(Device device)
    {
        var snackbar = _snackbar.Add("Waiting 30 seconds for response from device", Severity.Info, key: "ping_snackbar");

        await device.TurnOn(() => PingCompletedHandler(device, snackbar));

        StateHasChanged();
    }

    private void CheckDeviceStatus(Device device)
    {
        var snackbar = _snackbar.Add("Waiting 5 seconds for response from device", Severity.Info, key: "ping_snackbar");

        device.CheckStatus(() => PingCompletedHandler(device, snackbar));

        StateHasChanged();
    }

    private void PingCompletedHandler(Device device, Snackbar? snackbar)
    {

        if (device.Status == Device.StatusEnum.Online)
        {
            _snackbar.Remove(snackbar);
            _snackbar.Add($"{device.Name} is online", Severity.Success);
        }
        else if (device.Status == Device.StatusEnum.Offline)
        {
            _snackbar.Remove(snackbar);
            _snackbar.Add($"{device.Name} is offline", Severity.Error);
        }

        StateHasChanged();
    }
}