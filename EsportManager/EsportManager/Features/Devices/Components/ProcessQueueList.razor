@using EsportManager.Features.Process.Models
@using EsportManager.Resources.Strings
@using MudBlazor
@using EsportManager.Features.Devices.Models

<MudStack>
    @if (Device.ProcessQueue.Count > 0)
    {
        <MudStack Row Justify="Justify.FlexStart" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">@AppStrings.TaskQueue</MudText>
            @if (Device.ProcessQueue.All(q => q.Status == ProcessStatus.Initialized))
            {
                <MudButton OnClick="() => Device.StartQueue()" Variant="Variant.Filled" Color="Color.Info" Size="Size.Small">@AppStrings.StartQueue</MudButton>
            }
            <MudTooltip Text="@AppStrings.ClearQueue" Placement="Placement.Top"><MudIconButton onclick="() => Device.ClearQueue()" Icon="@Icons.Material.Filled.DoNotDisturb" Class="pa-0" Color="Color.Error" /></MudTooltip>
        </MudStack>
        <MudStack Row Justify="Justify.FlexStart">
            @foreach (var process in Device.ProcessQueue)
            {
                <MudCard>
                    <MudCardHeader Class="pb-0">
                        <CardHeaderContent>
                            <MudStack Row AlignItems="AlignItems.Center">
                                <MudText>@process.Name</MudText>
                                @if (process != null && process.IsRunning)
                                {
                                    <MudTooltip Text="@AppStrings.StopUpdate" Placement="Placement.Top"><MudIconButton onclick="() => process.Cancel(true)" Icon="@Icons.Material.Filled.DoNotDisturb" Class="pa-0" Color="Color.Error" /></MudTooltip>
                                }
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="0" Row>
                            @if (process.IsRunning)
                            {
                                <MudProgressCircular Color="Color.Info" Value="process.Progress" Indeterminate="process.Progress == 0" Size="Size.Small" />
                            }
                            else
                            {
                                <MudIcon Color="@GetProcessStatusColor(process)" Size="Size.Small" Icon="@GetProcessStatusIcon(process)" />
                            }
                            <MudText Class="mx-2">@AppStrings.StatusLabel</MudText>
                            <MudText>@process.Status</MudText>
                        </MudStack>
                        <MudStack Spacing="0" Row>
                            <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.ShortText" />
                            <MudText Class="mx-2">@AppStrings.OutputLabel</MudText>
                            <MudText>@process?.Output</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            }
        </MudStack>
    }
</MudStack>

@code {
    [Parameter]
    public Device Device { get; set; }

    private string GetProcessStatusIcon(DeviceProcess process)
    {
        if (process.Status == ProcessStatus.Initialized)
            return Icons.Material.Filled.Start;

        if (process.Status == ProcessStatus.CancelledByUser)
            return Icons.Material.Filled.Cancel;

        if (process.Status.IsError)
            return Icons.Material.Filled.Error;

        return Icons.Material.Filled.Done;
    }

    private Color GetProcessStatusColor(DeviceProcess process)
    {
        if (process.Status.Severity == Severity.Normal)
            return Color.Default;

        if (process.Status.Severity == Severity.Info)
            return Color.Info;

        if (process.Status.Severity == Severity.Warning)
            return Color.Warning;

        if (process.Status.Severity == Severity.Error)
            return Color.Error;

        return Color.Default;
    }
}