@page "/"
@using EsportManager.Data
@using MudBlazor
@using EsportManager.Features.Devices.Models
@using System.Diagnostics
@using System.Net
@inject IDatabase _database
@inject ISnackbar _snackbar

<MudTable T="Device" Items="Devices" @bind-SelectedItems="SelectedDevices" MultiSelection Hover SelectOnRowClick="false" Dense>
    <ToolBarContent>
        <MudStack Row Justify="Justify.SpaceBetween" Style="width: 100%">
            <MudText Typo="Typo.h6">Devices</MudText>
            <MudStack Row>
                <MudButton Variant="Variant.Filled" Color="Color.Primary">Update fortnite on selected devices</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success">Turn on selected devices</MudButton>
            </MudStack>
        </MudStack>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<Device, object>(x => x.Name)" InitialDirection="SortDirection.Descending" SortLabel="Sort By">Name</MudTableSortLabel></MudTh>
        <MudTh>Ip adress</MudTh>
        <MudTh>Mac adress</MudTh>
        <MudTh>State</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Ip adress">@context.IPAddress</MudTd>
        <MudTd DataLabel="Mac adress">@context.MacAdress</MudTd>
        <MudTd DataLabel="State">@context.State</MudTd>
        <MudTd>
            <MudStack Row Justify="Justify.FlexEnd" Class="mr-3">
                @if (context.ShowUpdateFortniteBtn)
                {
                    <MudTooltip Text="Update fortnite" Placement="Placement.Top"><MudIconButton Icon="@Icons.Material.Filled.Update" Class="pa-0" /></MudTooltip>
                }
                @if (context.ShowPowerOnBtn)
                {
                    <MudTooltip Text="Turn on" Placement="Placement.Top"><MudIconButton Icon="@Icons.Material.Filled.Power" Class="pa-0" /></MudTooltip>
                }
                @if (context.ShowSaveBtn)
                {
                    <MudTooltip Text="Save" Placement="Placement.Top"><MudIconButton OnClick="() => context.Save(_database.Connection, _snackbar)" Icon="@Icons.Material.Filled.Save" Class="pa-0" /></MudTooltip>
                }
            </MudStack>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<Device> Devices { get; set; } = [];

    private HashSet<Device> SelectedDevices { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await SearchForDevices();
    }

    public async Task SearchForDevices()
    {
        ProcessStartInfo processStartInfo = new("arp", "-a");
        processStartInfo.CreateNoWindow = true;
        processStartInfo.UseShellExecute = false;
        processStartInfo.RedirectStandardOutput = true;

        using (Process process = Process.Start(processStartInfo))
        {
            var output = process.StandardOutput.ReadToEnd();

            var lines = output.Split('\n');

            foreach(var line in lines)
            {
                if (line.Trim().StartsWith("192"))
                {
                    var items = line.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                    IPAddress ip = IPAddress.Parse(ipString: new(items[0]));
                    string macAdress = items[1];

                    Device device = new(ip, macAdress);
                    device.StateChanged += StateHasChanged;
                    device.GetHostName(_database.Connection);

                    Devices.Add(device);
                }
            }
        }
    }
}